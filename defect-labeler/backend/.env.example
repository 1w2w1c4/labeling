# 複製成 .env 後修改（環境變數一律以 DL_ 開頭）
DL_MONGO_URI=mongodb://localhost:27017
DL_MONGO_DB=avi
DL_REDIS_URL=redis://localhost:6379/0

# 外部身分從哪個 HTTP header 取得（實際方式待確認）
DL_IDENTITY_HEADER=X-User-Id
# 只限開發：沒有 header 時當作這個使用者（正式環境請留空）
DL_DEV_USER_ID=weichun

# 前端開發伺服器的網址（JSON 陣列）
DL_CORS_ORIGINS=["http://localhost:5173"]
